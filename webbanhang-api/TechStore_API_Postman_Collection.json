{
  "info": {
    "_postman_id": "techstore-web-api-v2",
    "name": "TechStore Web API v2 (JWT)",
    "description": "Bộ test đầy đủ cho TechStore Web API — Xác thực JWT\n\n## Hướng dẫn sử dụng\n1. Import file này vào Postman\n2. Đặt biến `base_url` = `http://localhost:8080/webbanhang-api`\n3. Chạy **Auth › Login** trước — copy `token` từ response\n4. Paste token vào biến `jwt_token`\n5. Các request đã được cấu hình sẵn `Authorization: Bearer {{jwt_token}}`\n\n## Tài khoản test\n- Admin: username=`admin`, password=`12345678@Admin`\n- User:  username=`user1`, password=`12345678@Admin`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",  "value": "http://localhost:8080/webbanhang-api", "type": "string" },
    { "key": "jwt_token", "value": "",                                     "type": "string",
      "description": "Paste token nhận được từ Login vào đây" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register — Đăng ký tài khoản mới",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"fullname\": \"Người Dùng Mới\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"123456\",\n  \"confirm_password\": \"123456\"\n}"
            },
            "url": "{{base_url}}/api/auth/register",
            "description": "Đăng ký tài khoản. Mật khẩu được hash bằng password_hash."
          }
        },
        {
          "name": "Login — Admin (lấy JWT token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('jwt_token', res.data.token);",
                  "    console.log('JWT token đã được lưu tự động.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"12345678@Admin\"\n}"
            },
            "url": "{{base_url}}/api/auth/login",
            "description": "Đăng nhập Admin. Token JWT sẽ được tự động lưu vào biến `jwt_token`."
          }
        },
        {
          "name": "Login — User thường",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('jwt_token', res.data.token);",
                  "    console.log('JWT token đã được lưu tự động.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"12345678@Admin\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Me — Thông tin user hiện tại [JWT]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{base_url}}/api/auth/me",
            "description": "Lấy thông tin user từ JWT token. Cần đăng nhập trước."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{base_url}}/api/auth/logout",
            "description": "JWT stateless — client tự xóa token."
          }
        },
        {
          "name": "Forgot Password — Quên mật khẩu",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@techstore.vn\"\n}"
            },
            "url": "{{base_url}}/api/auth/forgot-password",
            "description": "Gửi yêu cầu reset. Response trả về reset_token (mô phỏng — thực tế gửi qua email)."
          }
        },
        {
          "name": "Reset Password — Đặt lại mật khẩu",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset_token_từ_bước_trên>\",\n  \"new_password\": \"newpass123\",\n  \"confirm_password\": \"newpass123\"\n}"
            },
            "url": "{{base_url}}/api/auth/reset-password"
          }
        },
        {
          "name": "[Test] Đăng nhập sai mật khẩu → 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"sai_mat_khau\"\n}"
            },
            "url": "{{base_url}}/api/auth/login",
            "description": "Kỳ vọng: 401 Unauthorized"
          }
        },
        {
          "name": "[Test] Truy cập /me không có token → 401",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me",
            "description": "Kỳ vọng: 401 Unauthorized"
          }
        }
      ]
    },
