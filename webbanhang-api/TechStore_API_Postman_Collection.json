          }
        },
        {
          "name": "DELETE - Xóa 1 sản phẩm khỏi giỏ",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/cart/3",
            "description": "Xóa sản phẩm ID=3 khỏi giỏ"
          }
        },
        {
          "name": "DELETE - Xóa toàn bộ giỏ hàng",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/cart",
            "description": "Xóa toàn bộ giỏ hàng"
          }
        },
        {
          "name": "[Validation] POST - Sản phẩm không tồn tại",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 9999,\n  \"quantity\": 1\n}"
            },
            "url": "{{base_url}}/api/cart",
            "description": "Test: Kỳ vọng lỗi 404"
          }
        },
        {
          "name": "[Validation] POST - Số lượng = 0",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 0\n}"
            },
            "url": "{{base_url}}/api/cart",
            "description": "Test: Kỳ vọng lỗi 400"
          }
        }
      ]
    },
    {
      "name": "📋 Orders",
      "item": [
        {
          "name": "GET - Danh sách đơn hàng (Admin: tất cả)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/orders",
            "description": "Admin thấy tất cả, User thấy đơn của mình"
          }
        },
        {
          "name": "GET - Chi tiết đơn hàng",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/orders/1",
            "description": "Chi tiết đơn hàng ID = 1 kèm danh sách sản phẩm"
          }
        },
        {
          "name": "POST - Tạo đơn hàng từ giỏ",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Nguyễn Văn An\",\n  \"phone\": \"0901234567\",\n  \"address\": \"123 Nguyễn Huệ, Quận 1, TP.HCM\",\n  \"note\": \"Giao giờ hành chính\",\n  \"payment_method\": \"cod\"\n}"
            },
            "url": "{{base_url}}/api/orders",
            "description": "⚠️ Cần có sản phẩm trong giỏ hàng trước. Thanh toán COD"
          }
        },
        {
          "name": "POST - Tạo đơn hàng (thanh toán chuyển khoản)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Trần Thị Bình\",\n  \"phone\": \"0912345678\",\n  \"address\": \"456 Lê Lợi, Quận 3, TP.HCM\",\n  \"note\": \"\",\n  \"payment_method\": \"bank_transfer\"\n}"
            },
            "url": "{{base_url}}/api/orders"
          }
        },
        {
          "name": "PUT - Cập nhật trạng thái (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": "{{base_url}}/api/orders/1/status",
            "description": "Trạng thái hợp lệ: pending, confirmed, shipping, delivered, cancelled"
          }
        },
        {
          "name": "PUT - Cập nhật → shipping",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipping\"\n}"
            },
            "url": "{{base_url}}/api/orders/1/status"
          }
        },
        {
          "name": "PUT - Cập nhật → delivered",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"delivered\"\n}"
            },
            "url": "{{base_url}}/api/orders/1/status"
          }
        },
        {
          "name": "DELETE - Hủy đơn hàng",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/orders/2",
            "description": "Chỉ hủy được đơn ở trạng thái pending/confirmed"
          }
        },
        {
          "name": "[Validation] POST - Giỏ hàng rỗng",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Test\",\n  \"phone\": \"0901234567\",\n  \"address\": \"Test Address\",\n  \"payment_method\": \"cod\"\n}"
            },
            "url": "{{base_url}}/api/orders",
            "description": "Test: Kỳ vọng lỗi 400 - giỏ hàng rỗng (xóa giỏ trước)"
          }
        },
        {
          "name": "[Validation] PUT - Trạng thái không hợp lệ",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"invalid_status\"\n}"
            },
            "url": "{{base_url}}/api/orders/1/status",
            "description": "Test: Kỳ vọng lỗi 422"
          }
        }
      ]
    },
