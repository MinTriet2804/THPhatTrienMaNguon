            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/account/users/2?do=role",
              "query": [{ "key": "do", "value": "role" }]
            }
          }
        },
        {
          "name": "Admin: DELETE User — Xóa tài khoản [JWT+Admin]",
