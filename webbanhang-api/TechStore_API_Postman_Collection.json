{
  "info": {
    "_postman_id": "techstore-web-api-v1",
    "name": "TechStore Web API",
    "description": "Bộ test đầy đủ cho TechStore Web API\n\n## Hướng dẫn sử dụng\n1. Import file này vào Postman\n2. Đặt biến `base_url` = `http://localhost/webbanhang`\n3. Chạy Auth/Login trước để lấy session\n4. Kiểm tra từng endpoint theo thứ tự\n\n## Tài khoản test\n- Admin: username=`admin`, password=`12345678@Admin`\n- User: username=`user1`, password=`12345678@Admin`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/webbanhang",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"12345678@Admin\"\n}"
            },
            "url": "{{base_url}}/api/auth/login",
            "description": "Đăng nhập với quyền Admin"
          }
        },
        {
          "name": "Login - User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"12345678@Admin\"\n}"
            },
            "url": "{{base_url}}/api/auth/login",
            "description": "Đăng nhập với quyền User thường"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"fullname\": \"Người Dùng Mới\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"123456\",\n  \"confirm_password\": \"123456\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Get Me (thông tin user hiện tại)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me",
            "description": "Cần đăng nhập trước"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "📦 Products",
      "item": [
        {
          "name": "GET - Danh sách sản phẩm",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/products",
            "description": "Lấy tất cả sản phẩm kèm tên danh mục"
          }
        },
        {
          "name": "GET - Chi tiết sản phẩm",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/products/1",
            "description": "Lấy chi tiết sản phẩm có ID = 1"
          }
        },
        {
          "name": "GET - Tìm kiếm theo tên",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/search?q=iPhone",
              "query": [{ "key": "q", "value": "iPhone" }]
            },
            "url": "{{base_url}}/api/products/search?q=iPhone",
            "description": "Tìm kiếm sản phẩm theo tên"
          }
        },
        {
          "name": "GET - Lọc theo danh mục",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/filter?category_id=1",
              "query": [{ "key": "category_id", "value": "1" }]
            },
            "description": "Lọc sản phẩm thuộc danh mục ID = 1 (Điện thoại)"
          }
        },
        {
          "name": "GET - Sắp xếp theo giá tăng dần",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/sort?order=asc",
              "query": [{ "key": "order", "value": "asc" }]
            }
          }
        },
        {
          "name": "GET - Sắp xếp theo giá giảm dần",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/sort?order=desc",
              "query": [{ "key": "order", "value": "desc" }]
            }
          }
        },
        {
          "name": "POST - Thêm sản phẩm (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Samsung Galaxy S25 Ultra\",\n  \"description\": \"Chip Snapdragon 8 Elite, màn hình 6.9 inch, camera 200MP\",\n  \"price\": 31990000,\n  \"category_id\": 1,\n  \"image\": \"\"\n}"
            },
            "url": "{{base_url}}/api/products",
            "description": "⚠️ Cần đăng nhập với quyền Admin"
          }
        },
        {
          "name": "POST - Thêm sản phẩm kèm upload ảnh (Admin)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Xiaomi 15 Pro", "type": "text" },
                { "key": "description", "value": "Chip Snapdragon 8 Elite, camera Leica 50MP", "type": "text" },
                { "key": "price", "value": "25990000", "type": "text" },
                { "key": "category_id", "value": "1", "type": "text" },
                { "key": "image", "src": [], "type": "file", "description": "Chọn file ảnh .jpg/.png/.webp" }
              ]
            },
            "url": "{{base_url}}/api/products",
            "description": "Upload ảnh qua form-data. Cần đăng nhập Admin"
          }
        },
        {
          "name": "PUT - Cập nhật sản phẩm (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15 Pro Max (Updated)\",\n  \"description\": \"Chip A17 Pro nâng cấp, RAM 8GB\",\n  \"price\": 28990000,\n  \"category_id\": 1\n}"
            },
            "url": "{{base_url}}/api/products/1",
            "description": "Cập nhật sản phẩm ID = 1. Cần quyền Admin"
          }
        },
        {
          "name": "DELETE - Xóa sản phẩm (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/products/10",
            "description": "Xóa sản phẩm ID = 10. Cần quyền Admin"
          }
        },
        {
          "name": "[Validation] POST - Thiếu tên sản phẩm",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": 1000000,\n  \"category_id\": 1\n}"
            },
            "url": "{{base_url}}/api/products",
            "description": "Test: Kỳ vọng lỗi 422 - tên không được rỗng"
          }
        },
        {
          "name": "[Validation] POST - Giá âm",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Product\",\n  \"price\": -100,\n  \"category_id\": 1\n}"
            },
            "url": "{{base_url}}/api/products",
            "description": "Test: Kỳ vọng lỗi 422 - giá phải > 0"
          }
        }
      ]
    },
    {
      "name": "📁 Categories",
      "item": [
        {
          "name": "GET - Danh sách danh mục",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/categories",
