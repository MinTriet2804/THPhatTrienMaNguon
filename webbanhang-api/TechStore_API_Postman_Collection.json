        },
        {
          "name": "GET - Tổng tiền giỏ hàng",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/cart/total",
            "description": "Lấy subtotal, phí ship, grand total"
          }
        },
        {
          "name": "POST - Thêm sản phẩm vào giỏ",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}"
            },
            "url": "{{base_url}}/api/cart",
            "description": "Thêm sản phẩm ID=1 với số lượng 2"
