              "query": [{ "key": "do", "value": "toggle-active" }]
            },
            "description": "is_active: false = khóa, true = mở khóa"
          }
        },
        {
          "name": "Admin: Update Role — Đổi quyền [JWT+Admin]",
          "request": {
            "method": "PUT",
