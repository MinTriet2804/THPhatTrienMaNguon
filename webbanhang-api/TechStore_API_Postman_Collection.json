          }
        },
        {
          "name": "GET - Chi tiết danh mục",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/categories/1",
            "description": "Chi tiết danh mục ID = 1"
          }
        },
        {
          "name": "POST - Thêm danh mục (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Màn hình\",\n  \"description\": \"Màn hình máy tính, TV\"\n}"
            },
            "url": "{{base_url}}/api/categories",
            "description": "Cần quyền Admin"
          }
        },
        {
          "name": "PUT - Cập nhật danh mục (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Điện thoại thông minh\",\n  \"description\": \"Smartphone cao cấp các hãng\"\n}"
            },
            "url": "{{base_url}}/api/categories/1",
            "description": "Cập nhật danh mục ID = 1"
          }
        },
        {
          "name": "DELETE - Xóa danh mục (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/categories/6",
            "description": "Xóa danh mục ID = 6 (danh mục mới thêm). Sẽ báo lỗi 409 nếu còn sản phẩm"
          }
        },
        {
          "name": "[Validation] DELETE - Xóa danh mục còn sản phẩm",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/categories/1",
            "description": "Test: Kỳ vọng lỗi 409 - không xóa được vì còn sản phẩm"
          }
        }
      ]
    },
    {
      "name": "🛒 Cart",
      "item": [
        {
          "name": "GET - Xem giỏ hàng",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/cart",
            "description": "Cần đăng nhập"
